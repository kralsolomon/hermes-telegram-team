# Copy to .env (git-ignored) and fill in. scripts/setup.sh splits this into
# one .env per Hermes profile. NEVER commit the real .env.

# --- LLM provider (shared by all three agents) ---
# Anthropic key from console.anthropic.com (default in agents/*/config.yaml)
ANTHROPIC_API_KEY=sk-ant-...
# Only if you switch the configs to provider: openrouter
OPENROUTER_API_KEY=

# Optional: higher limits for the researcher's web search (Tavily also works keyless)
TAVILY_API_KEY=

# --- Telegram: who may talk to the team ---
# Your numeric user id (ask @userinfobot). Comma-separate for a pair: 111,222
TELEGRAM_ALLOWED_USERS=123456789
# The group's chat id (negative, e.g. -1001234567890). See README step 4.
TELEGRAM_GROUP_CHAT_ID=-100xxxxxxxxxx

# --- One bot per agent (from @BotFather) ---
COORDINATOR_BOT_TOKEN=
COORDINATOR_BOT_USERNAME=my_team_coordinator_bot   # without @

RESEARCHER_BOT_TOKEN=
RESEARCHER_BOT_USERNAME=my_team_researcher_bot

CODER_BOT_TOKEN=
CODER_BOT_USERNAME=my_team_coder_bot
